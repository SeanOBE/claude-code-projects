# Dedicated mailbox that suppliers send invoices to (e.g. invoices@yourstation.com)
IMAP_HOST=imap.gmail.com
IMAP_USER=invoices@yourstation.com
IMAP_FOLDER=Invoices   # ONLY this label/folder is read
IMAP_PASSWORD=app-password-here
# Where the monthly report is sent
SMTP_HOST=smtp.gmail.com
SMTP_USER=invoices@yourstation.com
SMTP_PASSWORD=app-password-here
REPORT_TO=accountant@yourstation.com
ANTHROPIC_API_KEY=sk-ant-...
